{
  "name": "@marginsheet/schema",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./conventions": "./src/conventions.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate:up": "tsx src/migrate.ts up",
    "migrate:down": "tsx src/migrate.ts down",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude '**/introspection.test.ts' --passWithNoTests",
    "test:introspection": "vitest run test/introspection.test.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.44",
    "postgres": "^3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "drizzle-kit": "^0.31",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^3"
  }
}
