# Isolation suite env. Copy to .env.isolation.dev and .env.isolation.staging,
# fill values, never commit (gitignored via .env.*).
# Run:  set -a; source .env.isolation.staging; set +a; pnpm test
#
# Hosts (not secret):
#   production (main): ep-rough-queen-au5epl01.c-10.us-east-1.aws.neon.tech
#   staging:           ep-odd-bread-auw7c71h.c-10.us-east-1.aws.neon.tech
#   dev:               ep-frosty-star-auf0zy79.c-10.us-east-1.aws.neon.tech
#
# Twilio is unset until M3; the Twilio check skips itself while the two
# TWILIO_ variables are absent and re-arms when they exist.

ISOLATION_TARGET=staging
PLAID_CLIENT_ID=
PLAID_SECRET=
STRIPE_SECRET=
NEON_DATABASE_URL=
EXPECTED_NEON_HOST=ep-odd-bread-auw7c71h.c-10.us-east-1.aws.neon.tech
PRODUCTION_NEON_HOST=ep-rough-queen-au5epl01.c-10.us-east-1.aws.neon.tech
