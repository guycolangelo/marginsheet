    "test:isolation": "vitest run test/isolation.test.ts",
    "test:db-identity": "vitest run test/db-identity.test.ts",
    "test:auth-adapter": "vitest run --no-file-parallelism test/auth-adapter.test.ts test/real-sign-in.test.ts test/magic-link-consumption.test.ts test/confirm-journey.test.ts test/no-account-enumeration.test.ts test/send-limits.test.ts test/passkey.test.ts test/phone-change.test.ts test/rls-resolver.test.ts test/recovery.test.ts"
